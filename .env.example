# TeraTTS server configuration. Copy this file to .env and adjust as needed.

# Network interface to bind. 0.0.0.0 listens on all interfaces.
TTS_HOST=0.0.0.0

# Port the HTTP server listens on.
TTS_PORT=10018

# HuggingFace Hub model id served by the TTS engine.
# Downloaded automatically on first run (see fetch_models.sh to pre-cache).
TTS_MODEL=TeraTTS/glados2-g2p-vits

# Speech speed. Lower is faster speech; 0.81 is the tuned default.
TTS_LENGTH_SCALE=0.81

# Base URL used by test_server.py to reach a running server.
TTS_TEST_URL=http://localhost:10018
